model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CSV_Location","Environment","Calendar","Sales","Product","Customer","Store","About"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode","CalcGroup","TMDLView_Desktop","DaxQueryView_Desktop","CopilotTooling","MCP-PBIModeling"]

ref table Calendar
ref table Sales
ref table Product
ref table Customer
ref table Store
ref table About
ref table 'Param - Field Selection'
ref table 'Time Intelligence'
ref table 'Param - Selected Cost'

ref role 'Store - Canada'
ref role 'Store - United States'

ref perspective Sales

ref cultureInfo en-US
ref cultureInfo pt-PT

